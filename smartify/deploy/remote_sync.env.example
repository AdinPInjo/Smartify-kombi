# Smartify Remote Sync Configuration
# Copy this file to /etc/smartify/remote_sync.env and configure

# Operating mode: "local" or "http"
# - local: File-based telemetry (no network, writes to /var/log/smartify/telemetry_outbox.jsonl)
# - http: Remote sync via Supabase Edge Functions
SMARTIFY_REMOTE_MODE=local

# Local API base URL (for sensor reading via HTTP fallback)
# Default: http://127.0.0.1:8000 (Smartify API on uvicorn)
SMARTIFY_LOCAL_API_BASE=http://127.0.0.1:8000

# ===== Remote sync configuration (required for http mode) =====

# Supabase Edge Functions base URL
# Find in: Supabase Dashboard → Project Settings → API
# Format: https://<project-ref>.supabase.co/functions/v1
SMARTIFY_REMOTE_BASE_URL=https://zihcfiaekaiflstqxxgc.supabase.co/functions/v1

# Supabase publishable/anon key (NOT service_role key!)
# Find in: Supabase Dashboard → Project Settings → API → Project API keys → anon/public
# This is safe to use on devices (Row Level Security enforces permissions)
SMARTIFY_SUPABASE_ANON_KEY=

# Device authentication token (treat like a password, keep secret)
# Generate with: openssl rand -hex 32
# Hash with SHA-256 and insert token_hash into devices table
# Store the RAW token here (not the hash)
SMARTIFY_DEVICE_TOKEN=

# Telemetry and settings sync intervals (optional, defaults in runner.py)
# SMARTIFY_TELEMETRY_INTERVAL=60
# SMARTIFY_STATE_CHECK_INTERVAL=15

