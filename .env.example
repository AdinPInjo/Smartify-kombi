# Copy to backend/.env (or the directory you start Smartify from) and adjust.
# Every setting is optional; the values below are the defaults.

# "mock" simulates all hardware (laptop/dev), "pi" uses the real devices.
SMARTIFY_HARDWARE=mock

SMARTIFY_HOST=0.0.0.0
SMARTIFY_PORT=8000
SMARTIFY_LOG_LEVEL=INFO
SMARTIFY_DATA_DIR=data

# Dashboard login. CHANGE BOTH before the dashboard is reachable from outside.
SMARTIFY_USERNAME=admin
SMARTIFY_PASSWORD=changeme
SMARTIFY_SECRET_KEY=change-this-secret

# DHT22 temperature/humidity sensors: BCM GPIO numbers, comma separated.
SMARTIFY_DHT22_PINS=4,17
SMARTIFY_SENSOR_INTERVAL_SECONDS=5

# ADS1115 analog-to-digital converter (water level sensor).
SMARTIFY_ADS1115_BUS=1
SMARTIFY_ADS1115_ADDRESS=72   # 72 = 0x48

# Relays created on first start (name:BCM pin). Ignored once relays exist;
# after that, manage them from the dashboard.
SMARTIFY_DEFAULT_RELAYS=heater:25,fan:26

# GPS receiver (NMEA over serial).
SMARTIFY_GPS_ENABLED=true
SMARTIFY_GPS_DEVICE=/dev/serial0
SMARTIFY_GPS_BAUD=9600
