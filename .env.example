# Copy to backend/.env (or the directory you start Smartify from) and adjust.
# Every setting is optional; the values below are the defaults.

# "mock" simulates all hardware (laptop/dev), "pi" uses the real devices.
SMARTIFY_HARDWARE=mock

SMARTIFY_HOST=0.0.0.0
SMARTIFY_PORT=8000
SMARTIFY_LOG_LEVEL=INFO
SMARTIFY_DATA_DIR=data
# Built dashboard to serve (after `npm run build` in frontend/). Optional.
# SMARTIFY_FRONTEND_DIR=../frontend/dist

# Dashboard login. With SMARTIFY_HARDWARE=pi, Smartify refuses to start while the
# password is still "changeme": anyone on the same WiFi could switch your relays.
SMARTIFY_USERNAME=admin
SMARTIFY_PASSWORD=changeme
# Signs login cookies. Leave empty: a random key is generated and kept in the data dir.
SMARTIFY_SECRET_KEY=

# DHT22 temperature/humidity sensors as name:BCM-pin pairs, comma separated.
# The names appear in the dashboard and are used in rules.
SMARTIFY_DHT22_SENSORS=inside:4,outside:17
SMARTIFY_SENSOR_INTERVAL_SECONDS=5
# Readings are averaged over this window before rules use them.
SMARTIFY_SENSOR_WINDOW_SECONDS=60
SMARTIFY_SENSOR_MIN_SAMPLES=3
# No good reading for this long: rules using the sensor switch their relay off.
SMARTIFY_SENSOR_STALE_SECONDS=600

# ADS1115 analog-to-digital converter (water level sensor + battery voltage).
SMARTIFY_ADS1115_BUS=1
SMARTIFY_ADS1115_ADDRESS=72   # 72 = 0x48
SMARTIFY_WATER_INTERVAL_SECONDS=10

# Relays created on first start (name:BCM-pin). Ignored once relays exist;
# after that, manage them from the dashboard.
SMARTIFY_DEFAULT_RELAYS=heater:25,fan:26
# How often automatic relays are checked against their rules.
SMARTIFY_RULE_INTERVAL_SECONDS=5

# GPS receiver (NMEA over serial).
SMARTIFY_GPS_ENABLED=true
SMARTIFY_GPS_DEVICE=/dev/serial0
SMARTIFY_GPS_BAUD=9600

# Victron devices over Bluetooth (Instant Readout), comma separated "name|MAC|key".
# Get MAC and key in VictronConnect: device > settings (gear) > Product info >
# Instant readout via Bluetooth: Enable, then "Show" next to Instant readout details.
# Names are used in the dashboard and in rules (e.g. battery_soc on "shunt").
# In mock mode an empty value simulates a SmartShunt, MPPT, Orion and MultiPlus.
# SMARTIFY_VICTRON_DEVICES=shunt|AA:BB:CC:DD:EE:01|0123456789abcdef0123456789abcdef,solar|AA:BB:CC:DD:EE:02|...
SMARTIFY_VICTRON_STALE_SECONDS=120

# Outside weather from Open-Meteo for the GPS position (needs internet).
SMARTIFY_WEATHER_ENABLED=true
SMARTIFY_WEATHER_INTERVAL_SECONDS=1800

# WiFi interface managed through NetworkManager.
SMARTIFY_WIFI_INTERFACE=wlan0

# History (sensors, water, GPS track, weather, relay events) older than this is deleted
# (checked every 6 hours). A daily database backup is kept in data/backups (last 3).
SMARTIFY_RETENTION_DAYS=90
