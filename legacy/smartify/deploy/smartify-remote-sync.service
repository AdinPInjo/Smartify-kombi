[Unit]
Description=Smartify Remote Sync Service
Documentation=https://github.com/your-repo/smartify
After=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__WORKING_DIR__

# Main command
ExecStart=/usr/bin/python3 __WORKING_DIR__/remote_sync/runner.py

# Load environment from config file
EnvironmentFile=/etc/smartify/remote_sync.env

# Restart policy - always restart on failure
Restart=always
RestartSec=10s
StartLimitInterval=400s
StartLimitBurst=5

# Logging
StandardOutput=append:/var/log/smartify/remote_sync_stdout.log
StandardError=append:/var/log/smartify/remote_sync_stderr.log
SyslogIdentifier=smartify-remote-sync

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
